# Used only by Prisma commands (npm run prisma:generate / prisma:migrate) for
# the planned database-backed version. `npm run dev` and `npm run build` need
# no .env — the app reads CSVs from data/imports at build time.

# Pooled connection for app queries (planned).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Direct/session connection for Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
