generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BudgetSide {
  revenue
  expenditure
}

enum BudgetBasis {
  actual
  planned
}

enum BudgetItemLevel {
  revenue_category
  public_spending_field
}

enum AdminSpendingLevel {
  admin_category
  major_program
}

enum MappingConfidence {
  high
  medium
  low
  unclassified
}

enum GdpAccountingStandard {
  sna_1993
  sna_2008
}

enum GdpStatus {
  final_as_published
  preliminary
}

// Mirror of data/taxonomy/{revenue-categories,spending-fields}.json merged with
// data/glossary/category-glossary.csv (IDs are 1:1 across the three files).
model BudgetItem {
  id          String          @id
  side        BudgetSide
  level       BudgetItemLevel
  kaLabel     String
  enLabel     String
  sortOrder   Int
  description String
  notes       String

  @@index([side, level])
}

// Mirror of data/taxonomy/admin-spending-categories.json.
model AdminSpendingCategory {
  id           String              @id
  kaLabel      String
  enLabel      String
  sortOrder    Int
  programFacts AdminSpendingFact[] @relation("AdminCategoryPrograms")
}

// Mirror of data/sources/source-documents.csv.
model SourceDocument {
  id              String       @id
  sourceName      String
  sourceUrlOrFile String
  lastReviewedAt  DateTime     @db.Date
  facts           BudgetFact[]
  gdpFacts        NationalGdpFact[]
  populationFacts MunicipalPopulationFact[]
  generalGovernmentBalanceFacts GeneralGovernmentBalanceFact[]
  gdpOverviewFacts GdpOverviewFact[]
}

model ImportRun {
  id                    String              @id @default(cuid())
  importLabel           String
  importedAt            DateTime            @default(now())
  rowsRead              Int
  rowsImported          Int
  totalRevenueGel       Decimal             @db.Decimal(18, 2)
  totalExpenditureGel   Decimal             @db.Decimal(18, 2)
  unclassifiedAmountGel Decimal             @db.Decimal(18, 2)
  unclassifiedShare     Decimal             @db.Decimal(9, 6)
  plannedRows           Int
  actualRows            Int
  reconciliationStatus  String
  warningsJson          Json
  reportJson            Json
  facts                 BudgetFact[]
  adminFacts            AdminSpendingFact[]
  gdpFacts              NationalGdpFact[]
  governmentDebtFacts   GovernmentDebtFact[]
  generalGovernmentBalanceFacts GeneralGovernmentBalanceFact[]
  gdpOverviewFacts GdpOverviewFact[]
  populationFacts       MunicipalPopulationFact[]
}

// Mirror of data/imports/budget-facts-2004-2025.csv.
// id is deterministic: `${year}:${side}:${itemId}:${basis}`.
// itemId is deliberately NOT a foreign key: the CSV contract also allows
// explicit `revenue.total` / `expenditure.total` rows that have no taxonomy
// entry (see lib/data/foundationValidation.ts); the import validates
// references with the same rules the site uses.
model BudgetFact {
  id                    String             @id
  year                  Int
  side                  BudgetSide
  itemId                String
  amountGel             Decimal            @db.Decimal(18, 2)
  basis                 BudgetBasis
  sourceDocumentId      String
  sourceDocument        SourceDocument     @relation(fields: [sourceDocumentId], references: [id])
  importRunId           String?
  importRun             ImportRun?         @relation(fields: [importRunId], references: [id])
  officialInstitution   String?
  officialProgram       String?
  officialSubprogram    String?
  publicSpendingFieldId String?
  mappingConfidence     MappingConfidence?
  mappingNotes          String

  @@unique([year, side, itemId, basis])
  @@index([year, side])
  @@index([itemId])
}

// Mirror of data/imports/admin-spending-facts-2004-2025.csv (ministries dataset,
// admin_category rows plus major_program drill-down rows).
// id is deterministic: `${year}:${itemId}`.
// sourceId is deliberately NOT a foreign key: the CSV contract allows
// `;`-joined multi-source values (see scripts/validate-data-files.ts); the
// import validates every `;`-split part against SourceDocument.
model AdminSpendingFact {
  id                         String                 @id
  year                       Int
  itemId                     String
  parentItemId               String?
  parent                     AdminSpendingCategory? @relation("AdminCategoryPrograms", fields: [parentItemId], references: [id])
  level                      AdminSpendingLevel
  amountGel                  Decimal                @db.Decimal(18, 2)
  basis                      BudgetBasis
  sourceId                   String
  importRunId                String?
  importRun                  ImportRun?             @relation(fields: [importRunId], references: [id])
  officialCode               String?
  officialLabelKa            String?
  officialInstitutionCode    String?
  officialInstitutionLabelKa String?
  mappingConfidence          MappingConfidence
  mappingNotes               String

  @@unique([year, itemId])
  @@index([year, level])
  @@index([parentItemId])
}

// Mirror of data/imports/national-gdp-annual-1996-2025.csv. The year is the
// natural key because the canonical reviewed series has one denominator per year.
model NationalGdpFact {
  year                Int                   @id
  gdpCurrentPricesGel Decimal               @db.Decimal(18, 2)
  accountingStandard GdpAccountingStandard
  status              GdpStatus
  sourceDocumentId    String
  sourceDocument      SourceDocument        @relation(fields: [sourceDocumentId], references: [id])
  sourceSheet         String
  sourceCell          String
  sourceUnit          String
  transformation      String
  lastReviewedAt      DateTime              @db.Date
  importRunId         String?
  importRun           ImportRun?            @relation(fields: [importRunId], references: [id])
}

// Mirror of data/imports/government-debt-facts-2013-2030.csv. The composite
// key permits exactly one approved annual value for each public debt series.
model GovernmentDebtFact {
  year           Int
  family         String
  seriesId       String
  value          Decimal?   @db.Decimal(24, 6)
  valueKind      String
  status         String
  sourceId       String?
  snapshotDate   DateTime?  @db.Date
  lastReviewedAt DateTime   @db.Date
  importRunId    String?
  importRun      ImportRun? @relation(fields: [importRunId], references: [id])

  @@id([year, seriesId])
  @@index([family, year])
}

// Mirror of data/imports/general-government-balance-annual-1995-2031.csv.
model GeneralGovernmentBalanceFact {
  year                               Int            @id
  generalGovernmentBalancePctGdp     Decimal        @db.Decimal(9, 3)
  generalGovernmentBalanceGel        Decimal        @db.Decimal(24, 0)
  status                             String
  sourceDocumentId                   String
  sourceDocument                     SourceDocument @relation(fields: [sourceDocumentId], references: [id])
  lastReviewedAt                     DateTime       @db.Date
  importRunId                        String?
  importRun                          ImportRun?     @relation(fields: [importRunId], references: [id])
}

enum MunicipalWarningType {
  none
  source_version_difference
  financing_outside_functional
  reconciliation_review_required
  source_actual_missing
}

// Mirror of data/taxonomy/municipal-functions.json.
model MunicipalFunctionCategory {
  id             String                         @id
  kaLabel        String
  functionalCode String                         @unique
  sortOrder      Int
  facts          MunicipalFunctionFact[]
  countryFacts   MunicipalCountryFunctionFact[]
}

// Mirror of data/taxonomy/municipal-regions.json.
model MunicipalRegion {
  id             String          @id
  kaLabel        String
  sortOrder      Int
  municipalities Municipality[]
}

// Mirror of data/imports/municipalities.csv.
// code is the official municipality code and stays text: leading zeros ("04")
// are part of the identifier.
model Municipality {
  code                String                  @id
  sortId              Int
  nameKa              String
  displayNameKa       String
  regionId            String
  region              MunicipalRegion         @relation(fields: [regionId], references: [id])
  isSelfGoverningCity Boolean
  functionFacts       MunicipalFunctionFact[]
  totalFacts          MunicipalTotalFact[]
  populationFacts     MunicipalPopulationFact[]

  @@index([regionId])
}

// Mirror of data/imports/municipal-population-2025.csv. Only the reviewed
// 2025 denominator is served; the full research panel remains source evidence.
model MunicipalPopulationFact {
  id                 String         @id
  year               Int
  municipalityCode   String
  municipality       Municipality   @relation(fields: [municipalityCode], references: [code])
  populationThousand Decimal        @db.Decimal(10, 1)
  populationPersons  Int
  referenceDate      DateTime       @db.Date
  sourceDocumentId   String
  sourceDocument     SourceDocument @relation(fields: [sourceDocumentId], references: [id])
  sourceSheet        String
  sourceCell         String
  sourceUnit         String
  transformation     String
  lastReviewedAt     DateTime       @db.Date
  importRunId        String?
  importRun          ImportRun?     @relation(fields: [importRunId], references: [id])

  @@unique([year, municipalityCode])
  @@index([municipalityCode])
}

// Mirror of data/imports/municipal-function-facts-2015-2025.csv.
// id is deterministic: `${year}:${municipalityCode}:${categoryId}`.
model MunicipalFunctionFact {
  id               String                    @id
  year             Int
  municipalityCode String
  municipality     Municipality              @relation(fields: [municipalityCode], references: [code])
  categoryId       String
  category         MunicipalFunctionCategory @relation(fields: [categoryId], references: [id])
  functionalCode   String
  amountGel        Decimal                   @db.Decimal(18, 2)
  basis            BudgetBasis
  sourceId         String

  @@unique([year, municipalityCode, categoryId])
  @@index([year])
  @@index([municipalityCode])
}

// Mirror of data/imports/municipal-total-facts-2015-2025.csv.
// id is deterministic: `${year}:${municipalityCode}`.
// The nullable component columns are null where the official source does not
// publish the value — never coerced to zero, which would read as "spent none".
model MunicipalTotalFact {
  id                          String               @id
  year                        Int
  municipalityCode            String
  municipality                Municipality         @relation(fields: [municipalityCode], references: [code])
  publicTotalGel              Decimal              @db.Decimal(18, 2)
  publicTotalMeasure          String
  totalPaymentsGel            Decimal?             @db.Decimal(18, 2)
  expensesGel                 Decimal?             @db.Decimal(18, 2)
  nonfinancialAssetGrowthGel  Decimal?             @db.Decimal(18, 2)
  financialAssetGrowthGel     Decimal?             @db.Decimal(18, 2)
  liabilityDecreaseGel        Decimal?             @db.Decimal(18, 2)
  functionalSumGel            Decimal              @db.Decimal(18, 2)
  reconciliationDifferenceGel Decimal?             @db.Decimal(18, 2)
  warningAmountGel            Decimal?             @db.Decimal(18, 2)
  showWarning                 Boolean
  warningType                 MunicipalWarningType
  basis                       BudgetBasis
  sourceId                    String

  @@unique([year, municipalityCode])
  @@index([year])
  @@index([municipalityCode])
}

// Mirror of data/imports/municipal-georgia-function-facts-2015-2025.csv.
// scopeId is the aggregate scope (`country.georgia`), not a Municipality.
model MunicipalCountryFunctionFact {
  id             String                    @id
  year           Int
  scopeId        String
  categoryId     String
  category       MunicipalFunctionCategory @relation(fields: [categoryId], references: [id])
  functionalCode String
  amountGel      Decimal                   @db.Decimal(18, 2)
  basis          BudgetBasis
  sourceId       String

  @@unique([year, scopeId, categoryId])
  @@index([year])
  @@index([scopeId])
}

// Mirror of data/imports/municipal-georgia-total-facts-2015-2025.csv.
// Nullable components remain null when the reviewed CSV has an empty cell.
model MunicipalCountryTotalFact {
  id                          String               @id
  year                        Int
  scopeId                     String
  publicTotalGel              Decimal              @db.Decimal(18, 2)
  publicTotalMeasure          String
  totalPaymentsGel            Decimal?             @db.Decimal(18, 2)
  expensesGel                 Decimal?             @db.Decimal(18, 2)
  nonfinancialAssetGrowthGel  Decimal?             @db.Decimal(18, 2)
  financialAssetGrowthGel     Decimal?             @db.Decimal(18, 2)
  liabilityDecreaseGel        Decimal?             @db.Decimal(18, 2)
  functionalSumGel            Decimal              @db.Decimal(18, 2)
  reconciliationDifferenceGel Decimal?             @db.Decimal(18, 2)
  warningAmountGel            Decimal?             @db.Decimal(18, 2)
  showWarning                 Boolean
  warningType                 MunicipalWarningType
  basis                       BudgetBasis
  sourceId                    String

  @@unique([year, scopeId])
  @@index([year])
  @@index([scopeId])
}

// Mirror of data/imports/municipal-adjara-budget-adjustments-2015-2025.csv.
model MunicipalAdjaraBudgetAdjustment {
  id                     String      @id
  year                   Int         @unique
  scopeId                String
  republicPaymentsGel    Decimal     @db.Decimal(18, 2)
  municipalTransfersGel  Decimal     @db.Decimal(18, 2)
  netRepublicPaymentsGel Decimal     @db.Decimal(18, 2)
  basis                  BudgetBasis
  republicSourceId       String
  transferSourceId       String

  @@index([scopeId])
}

model GdpOverviewFact {
  seriesId String
  year Int
  value Decimal @db.Decimal(40,20)
  unit String
  status String
  accountingStandard String?
  sourceLocator String
  sourceDocumentId String
  sourceDocument SourceDocument @relation(fields:[sourceDocumentId], references:[id])
  lastReviewedAt DateTime @db.Date
  importRunId String?
  importRun ImportRun? @relation(fields:[importRunId], references:[id])
  @@id([seriesId, year])
}
