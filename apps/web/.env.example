# Needed by database commands (npm run prisma:migrate, npm run data:import) and
# by builds with GEODATA_DATA_SOURCE=db. Dev and default builds need no .env.

# Pooled connection (Supabase, port 6543) for app queries at build time.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Direct/session connection (port 5432) for Prisma migrations and the import.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# The session pooler string (port 5432, user postgres.<project-ref>) is what
# this project uses for DIRECT_URL both locally and as the GitHub Actions
# secret: runners are IPv4-only and Supabase's true direct host
# (db.<ref>.supabase.co) is IPv6-only.

# Where the site reads data while pages are built: "csv" (default; reviewed
# files under data/imports) or "db" (the Supabase mirror populated by
# npm run data:import). Production builds set "db".
GEODATA_DATA_SOURCE=csv
