// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the Unemployment age heat map markup is recorded 1`] = `"<section data-testid="unemployment-age-heatmap" data-indicator="unemployment_rate" data-unit="percent" class="mt-12 border-t-2 border-[var(--ink)] pt-5"><h2 class="font-[family-name:var(--font-display)] text-[22px] font-semibold tracking-[-0.01em] text-[var(--ink)]">Age groups at a glance</h2><p class="mt-2 text-[12px] text-[var(--body)]">Unemployment rate · % · 2024–2025</p><p class="mt-2 max-w-[800px] text-[12px] leading-relaxed text-[var(--muted)]">All age groups, using the indicator and years chosen above. Stronger colour means a higher value; each cell shows the figure to one decimal. Missing observations appear as a dash.</p><div class="mt-5"><div data-testid="age-heatmap-scroller" role="region" aria-label="Unemployment rate · % · 2024–2025" tabindex="0" class="overflow-x-auto focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"><table class="w-full border-separate border-spacing-1 text-[13px]"><caption class="sr-only">Unemployment rate · % · 2024–2025</caption><thead><tr><th scope="col" class="sticky left-0 z-10 bg-[var(--paper)] px-3 py-2 text-left text-[11px] font-medium text-[var(--muted)]">Age</th><th scope="col" class="min-w-[78px] px-3 py-2 text-center font-[family-name:var(--font-numeric)] text-[11px] font-medium text-[var(--muted)]">2024</th><th scope="col" class="min-w-[78px] px-3 py-2 text-center font-[family-name:var(--font-numeric)] text-[11px] font-medium text-[var(--muted)]">2025</th></tr></thead><tbody><tr data-heatmap-group="age.15_19"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">15-19</th><td data-heatmap-cell="age.15_19:2024" data-value="36.29314580775541" data-bin="5" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#B3402A;color:var(--paper)">36.3%</td><td data-heatmap-cell="age.15_19:2025" data-value="39.01263150519571" data-bin="5" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#B3402A;color:var(--paper)">39.0%</td></tr><tr data-heatmap-group="age.20_24"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">20-24</th><td data-heatmap-cell="age.20_24:2024" data-value="26.919421364448848" data-bin="4" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#C4735A;color:var(--ink)">26.9%</td><td data-heatmap-cell="age.20_24:2025" data-value="30.174316427486904" data-bin="4" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#C4735A;color:var(--ink)">30.2%</td></tr><tr data-heatmap-group="age.25_29"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">25-29</th><td data-heatmap-cell="age.25_29:2024" data-value="19.125001172793375" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">19.1%</td><td data-heatmap-cell="age.25_29:2025" data-value="19.22940089301871" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">19.2%</td></tr><tr data-heatmap-group="age.30_34"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">30-34</th><td data-heatmap-cell="age.30_34:2024" data-value="17.736790014714114" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">17.7%</td><td data-heatmap-cell="age.30_34:2025" data-value="16.88435032275948" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">16.9%</td></tr><tr data-heatmap-group="age.35_39"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">35-39</th><td data-heatmap-cell="age.35_39:2024" data-value="13.471249426756767" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">13.5%</td><td data-heatmap-cell="age.35_39:2025" data-value="15.35688161332468" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">15.4%</td></tr><tr data-heatmap-group="age.40_44"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">40-44</th><td data-heatmap-cell="age.40_44:2024" data-value="14.5348308887912" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">14.5%</td><td data-heatmap-cell="age.40_44:2025" data-value="13.265927169931174" data-bin="2" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#DEBBA6;color:var(--ink)">13.3%</td></tr><tr data-heatmap-group="age.45_49"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">45-49</th><td data-heatmap-cell="age.45_49:2024" data-value="12.52729818142044" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">12.5%</td><td data-heatmap-cell="age.45_49:2025" data-value="12.864148101101843" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">12.9%</td></tr><tr data-heatmap-group="age.50_54"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">50-54</th><td data-heatmap-cell="age.50_54:2024" data-value="12.352761105630865" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">12.4%</td><td data-heatmap-cell="age.50_54:2025" data-value="12.5827446482587" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">12.6%</td></tr><tr data-heatmap-group="age.55_59"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">55-59</th><td data-heatmap-cell="age.55_59:2024" data-value="11.681158301420236" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">11.7%</td><td data-heatmap-cell="age.55_59:2025" data-value="10.828190860134077" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">10.8%</td></tr><tr data-heatmap-group="age.60_64"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">60-64</th><td data-heatmap-cell="age.60_64:2024" data-value="8.659213398287665" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">8.7%</td><td data-heatmap-cell="age.60_64:2025" data-value="8.139473435632066" data-bin="1" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#E9D6C6;color:var(--ink)">8.1%</td></tr><tr data-heatmap-group="age.65_plus"><th scope="row" class="sticky left-0 z-10 whitespace-nowrap bg-[var(--paper)] px-3 py-2 text-left font-normal text-[var(--ink)]">65+</th><td data-heatmap-cell="age.65_plus:2024" data-value="4.202487721584151" data-bin="0" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#F3EBDB;color:var(--ink)">4.2%</td><td data-heatmap-cell="age.65_plus:2025" data-value="3.492877777179758" data-bin="0" class="px-3 py-2 text-center font-[family-name:var(--font-numeric)] tabular-nums" style="background-color:#F3EBDB;color:var(--ink)">3.5%</td></tr></tbody></table></div></div><div class="mt-4 flex flex-wrap items-center gap-3 text-[11px] text-[var(--muted)]"><span>0.0%</span><span aria-hidden="true" class="flex"><span class="h-2 w-[18px]" style="background-color:#F3EBDB"></span><span class="h-2 w-[18px]" style="background-color:#E9D6C6"></span><span class="h-2 w-[18px]" style="background-color:#DEBBA6"></span><span class="h-2 w-[18px]" style="background-color:#D19A80"></span><span class="h-2 w-[18px]" style="background-color:#C4735A"></span><span class="h-2 w-[18px]" style="background-color:#B3402A"></span></span><span>39.0%</span><span>Lower to higher value</span></div></section>"`;
